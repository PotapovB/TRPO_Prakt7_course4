<Page x:Class="TRPO_Prakt7.Pages.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_Prakt7.Pages"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="Создание (изменение) задачи" HorizontalAlignment="Center" FontSize="20"/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox Text="{Binding Task.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" md:HintAssist.Hint="Введите название"/>
            <TextBox Text="{Binding Task.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" md:HintAssist.Hint="Введите описание"/>
            <TextBox Text="{Binding Task.Priority, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" md:HintAssist.Hint="Введите приоритет"/>
            <DatePickerTextBox Text="{Binding Task.Deadline, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" md:HintAssist.Hint="Введите дату"></DatePickerTextBox>
            <CheckBox IsChecked="{Binding Task.IsCompleted, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Content="Сделано"></CheckBox>
            <Button Content="Изменить существующую (Patch)" Click="PatchButton_Click" x:Name="PatchButton"/>
            <Button Content="Заменить (Put)" Click="PutButton_Click" x:Name="PutButton"/>
            <Button Content="Создать новую (Post)" Click="PostButton_Click"/>
            <Button Content="Назад" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
