<Page x:Class="TRPO_Prakt7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_Prakt7.Pages"
      mc:Ignorable="d"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <ListView ItemsSource="{Binding Tasks}"
                  Grid.Column="1"
                  VerticalAlignment="Stretch" 
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" x:Name="TaskListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Label Content="{Binding Title}"/>
                        <Label Content="{Binding Description}"/>
                        <TextBlock Text="{Binding Priority}"/>
                        <TextBlock Text="{Binding Deadline}"/>
                        <TextBlock Text="{Binding IsCompleted}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel>
            <Button Content="Получить записи" FontSize="12" Click="GetAllButton_Click"/>
            <TextBox Text="{Binding Priority}" md:HintAssist.Hint="Введите приоритет" />
            <StackPanel Background="LightGray">
                <Label Content="Сделано"></Label>
                <CheckBox x:Name="CompletedFilterCheckbox" Content="Фильтровать" Checked="CheckBox_Checked"></CheckBox>
                <CheckBox Content="Сделано" IsChecked="{Binding IsCompleted}">
                    
                </CheckBox>
            </StackPanel>
            <md:NumericUpDown Value="{Binding Id}" md:HintAssist.Hint="Введите номер задачи"/>
            <Button Content="Найти задачу" Click="GetByIdButton_Click"/>
            <Button Content="Добавить / изменить" Click="AddButton_Click"/>
            <Button Content="Удалить" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
